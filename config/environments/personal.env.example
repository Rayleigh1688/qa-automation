# Copy to .env.<operator>.fat.local or .env.<operator>.uat.local; chmod 600.
# Opt in with QA_ENV_LOCAL; each personal file belongs to exactly one environment.
# Empty entries override the base file too. Remove entries you do not override.
QA_OPERATOR=
WRITE_CLIENT_PHONE=
WRITE_CLIENT_PASSWORD=
CLIENT_WALLET_PASSWORD=
# Fill BET/WITHDRAW with the same fund account and password as WRITE_CLIENT_*.
BET_CLIENT_PHONE=
BET_CLIENT_PASSWORD=
WITHDRAW_CLIENT_PHONE=
WITHDRAW_CLIENT_PASSWORD=
# Per-run KYC generated with --new-kyc-account; never put BASIC/fund phone here.
REGISTER_PASSWORD=
KYC_IMAGE=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_LOGIN_TOTP_SECRET=
ADMIN_APPROVAL_TOTP_SECRET=
