# One file represents exactly one environment.
# Full schema reference. Start from config/environments/fat.env.example or uat.env.example.
# Personal overrides: QA_ENV_LOCAL=.env.<operator>.fat.local (ignored, chmod 600).
QA_OPERATOR=
EXECUTE_BET=false
EXECUTE_DEPOSIT_CONTRACT=false
EXECUTE_WITHDRAW_UI=false

# Target URLs 
API_URL=https://client-fat.filbet2025.com
ADMIN_URL=https://admin-fat.filbet2025.com
CLIENT_BASE_URL=https://client-fat.filbet2025.com
AGENCY_URL=

# Shared request defaults
CLIENT_AUTH_MODE=password
DEVICE=25
LANG_HEADER=en_US
ADMIN_LANG_HEADER=en
ADMIN_CLIENT_ID=123
ADMIN_CLIENT_VERSION=Chrome/151.0.0.0
PLAYWRIGHT_CHANNEL=

# readonly_mature_account: repeatable API/UI checks
CLIENT_PHONE=9776565625
CLIENT_PASSWORD=<local client password>
CLIENT_AUTH_MODE=aa111111
CLIENT_OTP=111111
CLIENT_OTP_SOURCE=fixed
APPROVED_KYC_CLIENT_PHONE=9776565625
APPROVED_KYC_CLIENT_OTP=111111

# fund_flow_account: deposit -> bet -> turnover -> withdraw; all aliases are the same account
WRITE_CLIENT_PHONE=<fund flow account phone>
WRITE_CLIENT_PASSWORD=<local client password>
WRITE_CLIENT_OTP=<optional; explicit OTP flows only>
# Fill aliases with the same WRITE_CLIENT_* values (no variable expansion).
BET_CLIENT_PHONE=
BET_CLIENT_PASSWORD=
BET_CLIENT_OTP=<optional; explicit OTP flows only>
WITHDRAW_CLIENT_PHONE=
WITHDRAW_CLIENT_PASSWORD=
WITHDRAW_CLIENT_OTP=<optional; explicit OTP flows only>
CLIENT_WALLET_PASSWORD=<numeric wallet password for gated UI withdrawal>
CLIENT_WITHDRAW_CHANNEL=Maya
P0_DEPOSIT_AMOUNT=1200
# Optional environment-specific channel id; leave empty to select from current mode=1 channels
P0_DEPOSIT_PID=
P0_WITHDRAW_AMOUNT=1000

# kyc_new_account_pool: separate from fund flow and permanent-unverified accounts
KYC_CLIENT_PHONE=<fresh account for this run only>
KYC_CLIENT_UID=<optional known uid>
KYC_CLIENT_PASSWORD=<local KYC account password>
KYC_CLIENT_OTP=<environment otp>
KYC_IMAGE=<local ignored KYC image path>
REGISTER_PHONE=
REGISTER_PASSWORD=<local new-account password>
PROVISION_MAYA_PID=<environment Maya payment_platform_id>
REGISTER_OTP=<environment otp>
REGISTER_OTP_SOURCE=fixed

# permanent_unverified_account: never submit KYC or set a wallet password
PRE_KYC_CLIENT_PHONE=<permanent BASIC account phone>
PRE_KYC_CLIENT_PASSWORD=<optional local password>
PRE_KYC_CLIENT_OTP=<environment otp>

# admin_operator: read checks plus approvals for the current controlled flow only
ADMIN_EMAIL=<admin email>
ADMIN_PASSWORD=<admin password>
ADMIN_GOOGLE_CODE=<environment login code>
ADMIN_LOGIN_TOTP_SECRET=<optional dynamic login seed; falls back to approval seed>
ADMIN_LOGIN_TOTP_ALGORITHM=<optional; falls back to approval algorithm>
ADMIN_DEVICE_ID=<browser x-device-id>
ADMIN_GOOGLE_SECRET=
ADMIN_TOKEN_PREFIX=
ADMIN_APPROVAL_CODE=
ADMIN_APPROVAL_TOTP_SECRET=<approval totp secret>
ADMIN_APPROVAL_TOTP_ALGORITHM=SHA256
EXPECTED_ADMIN_APPROVAL_CODE=

# Safe negative-test constants
P0_NEGATIVE_OTP=000000
P0_NEGATIVE_WITHDRAW_AMOUNT=1
P0_NEGATIVE_WITHDRAW_ACCOUNT_ID=99999999999999999
P0_DEPOSIT_CASHBACK_FLAG=0
P0_DEPOSIT_ROTATION_FLAG=0

# Both FAT and UAT use a 100 business bet; each environment selects its own game
CLIENT_GAME_ID=lucky_penny
CLIENT_GAME_PAGE_PATH=/s-game-page/17453858840928
CLIENT_GAME_BET_AMOUNT=100
CLIENT_GAME_SPIN_COUNT=1
# auto selects admin for UAT and read-only database for FAT
TURNOVER_SOURCE=auto

# Optional debug tokens. Prefer ignored generated session files instead.
API_TOKEN=
ADMIN_TOKEN=
AGENCY_TOKEN=

# Optional local read-only database diagnostics. Never use write-capable credentials.
DB_HOST=<mysql host>
DB_PORT=3306
DB_USER=<read-only mysql user>
DB_PASSWORD=<local secret>
DB_NAME=<database name>

# P1-only lanes are intentionally omitted from P0 environment files.
