{
  "name": "qa-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean:api-results": "python3 scripts/clean-test-artifacts.py api",
    "clean:ui-results": "python3 scripts/clean-test-artifacts.py ui",
    "test:ui": "npm run clean:ui-results && playwright test",
    "test:api": "python3 scripts/run-api-tests.py p0",
    "test:api:read": "python3 scripts/run-api-tests.py p0 --safe-only",
    "test:api:write": "npm run test:api",
    "test:p0:api": "python3 scripts/run-api-tests.py p0",
    "test:p0:api:read": "npm run test:api:read",
    "test:p0:api:register": "python3 scripts/api-controlled-flow-runner.py --operation register --insecure --body-format cbor",
    "test:p0:api:kyc-submit": "python3 scripts/api-controlled-flow-runner.py --operation kyc-submit --insecure --body-format cbor",
    "test:p0:api:kyc-approve": "python3 scripts/api-controlled-flow-runner.py --operation kyc-approve --insecure --body-format cbor",
    "test:p0:api:kyc": "python3 scripts/api-controlled-flow-runner.py --submit-kyc --approve-kyc --use-register-phone --flow-name kyc --insecure --body-format cbor --out api/results/operations/kyc.json",
    "test:p0:api:deposit-create": "python3 scripts/api-controlled-flow-runner.py --operation deposit-create --insecure --body-format cbor",
    "test:p0:api:deposit-check-client": "python3 scripts/api-controlled-flow-runner.py --operation deposit-check-client --insecure --body-format cbor",
    "test:p0:api:deposit-check-admin": "python3 scripts/api-controlled-flow-runner.py --operation deposit-check-admin --insecure --body-format cbor",
    "test:p0:api:deposit-approve": "python3 scripts/api-controlled-flow-runner.py --operation deposit-approve --insecure --body-format cbor",
    "test:p0:api:withdraw-create": "python3 scripts/api-controlled-flow-runner.py --operation withdraw-create --insecure --body-format cbor",
    "test:p0:api:withdraw-account-prepare": "python3 scripts/api-controlled-flow-runner.py --operation withdraw-account-prepare --use-register-phone --insecure --body-format cbor",
    "test:p0:api:withdraw": "python3 scripts/api-controlled-flow-runner.py --withdraw --check-client-withdraw-list --check-admin-withdraw-list --use-register-phone --withdraw-amount 100 --flow-name withdraw --insecure --body-format cbor --out api/results/operations/withdraw.json",
    "test:p0:api:withdraw-check-client": "python3 scripts/api-controlled-flow-runner.py --operation withdraw-check-client --insecure --body-format cbor",
    "test:p0:api:withdraw-check-admin": "python3 scripts/api-controlled-flow-runner.py --operation withdraw-check-admin --insecure --body-format cbor",
    "test:p0:api:withdraw-approve": "python3 scripts/api-controlled-flow-runner.py --operation withdraw-approve --insecure --body-format cbor",
    "test:p0:api:turnover-clear": "python3 scripts/api-controlled-flow-runner.py --operation turnover-clear --insecure --body-format cbor",
    "test:p0:api:deposit-clear-turnover": "python3 scripts/api-controlled-flow-runner.py --deposit --approve-deposit --clear-turnover --use-register-phone --deposit-amount 1200 --flow-name deposit-clear-turnover --insecure --body-format cbor --out api/results/operations/deposit-clear-turnover.json",
    "test:p0:ui": "npm run test:ui:p0",
    "test:p0": "python3 scripts/run-p0-tests.py --mode quick",
    "test:p0:full": "python3 scripts/run-p0-tests.py --mode full",
    "test:ui:p0": "python3 scripts/run-ui-p0-tests.py",
    "test:ui:p0:scan": "npm run clean:ui-results && playwright test ui/cases/client-main-flow.spec.mjs",
    "test:ui:network-discovery": "npm run clean:ui-results && playwright test ui/cases/client-network-discovery.spec.mjs",
    "test:ui:p0:pn": "npm run clean:ui-results && playwright test ui/cases/client-p0-positive-negative.spec.mjs",
    "test:ui:inventory": "npm run clean:ui-results && playwright test ui/cases/client-locator-inventory.spec.mjs",
    "test:ui:login": "npm run clean:ui-results && playwright test ui/cases/client-login.spec.mjs",
    "test:ui:deposit-contract": "npm run clean:ui-results && playwright test ui/cases/client-deposit-contract.spec.mjs",
    "test:ui:withdraw-contract": "npm run clean:ui-results && CLIENT_REUSE_P0_AUTH=true playwright test ui/cases/client-withdraw-contract.spec.mjs --workers=1",
    "test:ui:unverified-withdraw": "npm run clean:ui-results && playwright test ui/cases/client-unverified-withdraw.spec.mjs --workers=1",
    "test:ui:game-bet": "npm run clean:ui-results && playwright test ui/cases/client-game-bet-smoke.spec.mjs",
    "test:ui:modal-debug": "npm run clean:ui-results && playwright test ui/cases/client-modal-debug.spec.mjs",
    "ui:p0-points": "npm run clean:ui-results && node scripts/render-ui-p0-test-points.mjs",
    "test:ui:headed": "npm run clean:ui-results && playwright test --headed"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "playwright": "^1.57.0"
  }
}
